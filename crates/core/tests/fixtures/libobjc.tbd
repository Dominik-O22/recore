--- !tapi-tbd
tbd-version:     4
targets:         [ x86_64-macos, arm64-macos, arm64e-macos ]
install-name:    '/usr/lib/libobjc.A.dylib'
exports:
  - targets:         [ x86_64-macos, arm64-macos, arm64e-macos ]
    symbols:         [ _objc_msgSend, _objc_msgSendSuper2, __objc_empty_cache, _objc_alloc, _objc_opt_class ]
    objc-classes:    [ NSObject ]
...
